{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "harden-shell-history-mod"},
  "spec": {
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "matchPaths": [
        {"path": "/root/*_history", "fromSource": [{"path": "/usr/bin/shred"}, {"path": "/usr/bin/rm"}, {"path": "/bin/mv"}, {"path": "/bin/rm"}, {"path": "/usr/bin/mv"}]},
        {"path": "/home/*/*_history", "fromSource": [{"path": "/usr/bin/shred"}, {"path": "/usr/bin/rm"}, {"path": "/bin/rm"}, {"path": "/bin/mv"}, {"path": "/usr/bin/mv"}]}
      ]
    },
    "process": {
      "matchPaths": [
        {"path": "/usr/bin/shred"},
        {"path": "/usr/bin/rm"},
        {"path": "/bin/mv"},
        {"path": "/bin/rm"},
        {"path": "/usr/bin/mv"}
      ]
    },
    "message": "Alert! shell history modification or deletion detected and prevented",
    "severity": 5,
    "tags": ["CIS", "NIST_800-53", "NIST_800-53_CM-5", "NIST_800-53_AU-6(8)", "MITRE_T1070_indicator_removal_on_host", "MITRE", "MITRE_T1036_masquerading"],
    "action": "Audit"
  }
}
