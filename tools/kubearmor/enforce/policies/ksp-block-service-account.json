{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-block-service-account"},
  "spec": {
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "matchDirectories": [
        {"dir": "/run/secrets/kubernetes.io/serviceaccount/", "recursive": true},
        {"dir": "/var/run/secrets/kubernetes.io/serviceaccount/", "recursive": true}
      ],
      "matchPaths": [
        {"path": "/var/run/docker.sock"},
        {"path": "/run/docker.sock"},
        {"path": "/run/containerd/containerd.sock"},
        {"path": "/var/run/crio/crio.sock"}
      ]
    },
    "message": "Container credential or container runtime API access",
    "severity": 7,
    "tags": ["MITRE", "MITRE_T1528_steal_application_access_token", "MITRE_T1552.007_container_api"],
    "action": "Block"
  }
}
