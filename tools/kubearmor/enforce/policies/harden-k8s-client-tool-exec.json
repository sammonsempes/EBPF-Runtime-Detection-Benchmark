{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "harden-k8s-client-tool-exec"},
  "spec": {
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchPaths": [
        {"path": "/usr/local/bin/kubectl"},
        {"path": "/usr/bin/kubectl"},
        {"path": "/usr/local/bin/docker"},
        {"path": "/usr/bin/docker"},
        {"path": "/usr/local/bin/crictl"},
        {"path": "/usr/bin/crictl"}
      ]
    },
    "message": "Alert! k8s client tool executed inside container.",
    "severity": 5,
    "tags": ["MITRE_T1609_container_administration_command", "MITRE_TA0002_execution", "MITRE_T1610_deploy_container", "MITRE", "NIST_800-53", "NIST_800-53_AU-2", "NIST_800-53_SI-4", "NIST"],
    "action": "Block"
  }
}
