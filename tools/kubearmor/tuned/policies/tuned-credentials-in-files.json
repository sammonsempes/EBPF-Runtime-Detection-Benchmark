{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "tuned-credentials-in-files"},
  "spec": {
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "matchDirectories": [
        {"dir": "/root/.aws/", "recursive": true},
        {"dir": "/root/.kube/", "recursive": true},
        {"dir": "/root/.docker/", "recursive": true}
      ],
      "matchPatterns": [
        {"pattern": "/root/.ssh/id_*"},
        {"pattern": "/home/*/.ssh/id_*"},
        {"pattern": "/home/*/.aws/*"},
        {"pattern": "/**/.env"},
        {"pattern": "/**/.git-credentials"},
        {"pattern": "/**/.pgpass"}
      ]
    },
    "message": "Access to files that commonly hold plaintext credentials",
    "severity": 7,
    "tags": ["MITRE", "MITRE_T1552.001_credentials_in_files", "MITRE_TA0006_credential_access"],
    "action": "Audit"
  }
}
