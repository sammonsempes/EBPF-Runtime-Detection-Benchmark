{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-tactic-credential-access-unsecured-credentials-private-keys"},
  "spec": {
    "tags": ["MITRE", "T1552", "system"],
    "message": "Credentials access denied",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "action": "Audit",
    "file": {
      "matchDirectories": [
        {"dir": "/etc/ssl/", "recursive": true},
        {"dir": "/etc/pki/", "recursive": true},
        {"dir": "/usr/local/share/ca-certificates/", "recursive": true}
      ]
    }
  }
}
