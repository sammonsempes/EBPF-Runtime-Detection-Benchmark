{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-discovery-process-discovery"},
  "spec": {
    "tags": ["MITRE", "Discovery"],
    "message": "Someone accessed running process",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchPaths": [
        {"path": "/bin/ps"},
        {"path": "/usr/bin/ps"},
        {"path": "/usr/bin/pgrep"},
        {"path": "/usr/bin/top"},
        {"path": "/usr/bin/htop"}
      ],
      "action": "Audit",
      "severity": 5
    }
  }
}
