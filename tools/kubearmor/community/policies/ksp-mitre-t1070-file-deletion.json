{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1070-file-deletion"},
  "spec": {
    "tags": ["MITRE", "Defense-Evasion", "D3fend", "Permission", "T1070.004"],
    "message": "Notifications! Deletion commands has been accessed",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/usr/bin/rm"},
        {"path": "/usr/bin/unlink"},
        {"path": "/usr/bin/rmdir"}
      ],
      "matchPatterns": [
        {"pattern": "/**/rm"},
        {"pattern": "/**/rmdir"},
        {"pattern": "/**/unlink"}
      ],
      "action": "Audit"
    }
  }
}
