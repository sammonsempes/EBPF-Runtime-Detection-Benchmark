{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-defense-evasion-deobfuscate"},
  "spec": {
    "tags": ["MITRE", "system", "K8s", "base32"],
    "message": "Someone decoded file information",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchPaths": [
        {"path": "/usr/bin/base32"},
        {"path": "/usr/bin/base16"},
        {"path": "/usr/bin/base32plain"},
        {"path": "/usr/bin/base32hex"}
      ],
      "action": "Audit",
      "severity": 3
    }
  }
}
