{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-tactic-execution-remote-code-exec-in-container"},
  "spec": {
    "tags": ["MITRE", "T1210", "NIST", "SI-4"],
    "message": "Netcat runs inside a container that allows remote code execution",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 6,
      "matchPaths": [
        {"path": "/usr/bin/nc"},
        {"path": "/usr/bin/ncat"}
      ],
      "matchPatterns": [
        {"pattern": "/*/nc"},
        {"pattern": "/*/*/nc"},
        {"pattern": "/*/ncat"},
        {"pattern": "/*/*/ncat"}
      ],
      "action": "Audit"
    }
  }
}
