{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1610-tactic-execution-blocking-docker"},
  "spec": {
    "tags": ["MITRE", "T1610"],
    "message": "Blocking the docker execution in the k8s environment",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/usr/bin/docker"}
      ],
      "action": "Audit"
    }
  }
}
