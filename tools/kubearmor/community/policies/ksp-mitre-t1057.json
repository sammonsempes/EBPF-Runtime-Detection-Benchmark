{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1057"},
  "spec": {
    "tags": ["MITRE", "T1057", "Discovery"],
    "message": "Someone Tried to Access Running Process Details",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/bin/ps"},
        {"path": "/usr/bin/ps"},
        {"path": "/usr/bin/pgrep"},
        {"path": "/usr/bin/top"},
        {"path": "/usr/bin/htop"}
      ],
      "action": "Audit"
    }
  }
}
