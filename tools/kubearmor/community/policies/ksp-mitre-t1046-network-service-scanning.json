{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1046-network-service-scanning"},
  "spec": {
    "tags": ["MITRE", "T1046"],
    "message": "Network service commands has been executed in the system",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/usr/bin/netstat"},
        {"path": "/bin/netstat"},
        {"path": "/usr/sbin/ip"},
        {"path": "/usr/bin/ip"},
        {"path": "/sbin/ip"},
        {"path": "/bin/ip"},
        {"path": "/usr/sbin/iw"},
        {"path": "/sbin/iw"},
        {"path": "/usr/sbin/ethtool"},
        {"path": "/sbin/ethtool"},
        {"path": "/usr/sbin/ifconfig"},
        {"path": "/sbin/ifconfig"},
        {"path": "/usr/sbin/arp"},
        {"path": "/sbin/arp"},
        {"path": "/usr/sbin/iwconfig"},
        {"path": "/sbin/iwconfig"}
      ],
      "action": "Audit"
    }
  }
}
