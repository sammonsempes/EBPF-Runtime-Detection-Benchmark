{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-tactic-credential-access-password-dumping"},
  "spec": {
    "tags": ["MITRE", "T1003"],
    "message": "Credential access password dumping",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "severity": 4,
      "matchPaths": [
        {"path": "/etc/passwd"},
        {"path": "/etc/shadow"}
      ],
      "action": "Audit"
    }
  }
}
