{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1053-persistence-external-remote-services"},
  "spec": {
    "tags": ["MITRE", "T1053"],
    "message": "Password File and ssh Sensitive Files is Audited",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "severity": 3,
      "matchPaths": [
        {"path": "/var/log/wtmp"},
        {"path": "/var/run/utmp"},
        {"path": "/var/log/auth.log"},
        {"path": "/etc/passwd"},
        {"path": "/etc/shadow"}
      ],
      "matchDirectories": [
        {"dir": "/etc/ssh/"}
      ],
      "action": "Audit"
    }
  }
}
