{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1059.yaml"},
  "spec": {
    "tags": ["MITRE", "T1059"],
    "message": "New Startup Automated Script detected -- possibly the adversary is trying to run malicious code",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "file": {
      "severity": 5,
      "matchDirectories": [
        {"dir": "/etc/rc0.d/"},
        {"dir": "/etc/rc1.d/"},
        {"dir": "/etc/rc2.d/"},
        {"dir": "/etc/rcS.d/"}
      ],
      "action": "Audit"
    }
  }
}
