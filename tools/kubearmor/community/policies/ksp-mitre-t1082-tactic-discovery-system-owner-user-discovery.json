{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1082-tactic-discovery-system-owner-user-discovery"},
  "spec": {
    "tags": ["MITRE", "T1082"],
    "message": "System owner discovery command is blocked",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 3,
      "matchPaths": [
        {"path": "/usr/bin/who"},
        {"path": "/usr/bin/w"},
        {"path": "/usr/bin/id"},
        {"path": "/usr/bin/whoami"}
      ]
    },
    "action": "Audit"
  }
}
