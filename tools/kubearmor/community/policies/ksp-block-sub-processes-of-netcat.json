{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-block-sub-processes-of-netcat"},
  "spec": {
    "tags": ["MITRE"],
    "message": "binary forked through netcat",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchPaths": [
        {"path": "/usr/bin/**", "fromSource": [{"path": "/usr/bin/netcat"}]},
        {"path": "/usr/bin/**", "fromSource": [{"path": "/usr/bin/nc"}]}
      ],
      "action": "Audit",
      "severity": 4
    }
  }
}
