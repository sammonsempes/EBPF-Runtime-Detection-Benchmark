{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1053-scheduled-task-job-at"},
  "spec": {
    "tags": ["MITRE", "T1053", "Execution", "at"],
    "message": "Task job has been accessed",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/etc/at.allow"},
        {"path": "/etc/at.deny"},
        {"path": "/usr/bin/at"}
      ],
      "action": "Audit"
    }
  }
}
