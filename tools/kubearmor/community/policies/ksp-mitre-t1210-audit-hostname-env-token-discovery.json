{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-t1210-audit-hostname-env-token-discovery"},
  "spec": {
    "tags": ["MITRE", "T1210", "NIST", "NIST-800-53-r5", "SC-11", "Trusted Path"],
    "message": "Hostname, env or k8s token accessed by unknown -- possible lateral movement ",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/bin/hostname", "ownerOnly": true},
        {"path": "/usr/bin/env", "ownerOnly": true}
      ],
      "action": "Audit"
    },
    "file": {
      "severity": 5,
      "matchPaths": [
        {"path": "/etc/hostname", "ownerOnly": true}
      ],
      "matchDirectories": [
        {"dir": "/var/run/secrets/kubernetes.io/serviceaccount/", "ownerOnly": true}
      ],
      "action": "Audit"
    }
  }
}
