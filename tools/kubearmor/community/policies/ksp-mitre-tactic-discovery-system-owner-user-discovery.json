{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-tactic-discovery-system-owner-user-discovery"},
  "spec": {
    "tags": ["MITRE", "Discovery"],
    "message": "Someone tried to access user details",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchPaths": [
        {"path": "/usr/bin/who"},
        {"path": "/usr/bin/w"},
        {"path": "/usr/bin/id"},
        {"path": "/usr/bin/whoami"}
      ],
      "action": "Audit",
      "severity": 3
    }
  }
}
