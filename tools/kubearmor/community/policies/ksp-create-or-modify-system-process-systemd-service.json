{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-create-or-modify-system-process-systemd-service"},
  "spec": {
    "tags": ["MITRE", "system", "K8s", "T1543"],
    "message": "Warning! someone created or Modified the system process",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "matchDirectories": [
        {"dir": "/etc/systemd/system/", "recursive": true},
        {"dir": "/usr/lib/systemd/", "recursive": true},
        {"dir": "/lib/systemd/system/", "recursive": true}
      ],
      "action": "Audit",
      "severity": 5
    },
    "file": {
      "matchDirectories": [
        {"dir": "/etc/systemd/system/", "recursive": true, "readOnly": false},
        {"dir": "/usr/lib/systemd/", "recursive": true, "readOnly": false},
        {"dir": "/lib/systemd/system/", "recursive": true, "readOnly": false}
      ],
      "action": "Audit",
      "severity": 5
    }
  }
}
