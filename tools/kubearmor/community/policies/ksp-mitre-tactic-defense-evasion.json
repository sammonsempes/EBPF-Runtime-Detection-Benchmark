{
  "kind": "KubeArmorPolicy",
  "metadata": {"namespaceName": "bench", "policyName": "ksp-mitre-tactic-defense-evasion"},
  "spec": {
    "tags": ["MITRE", "T1218"],
    "message": "Certificates files have been accessed!",
    "selector": {"matchLabels": {"kubearmor.io/container.name": "bench-victim"}},
    "process": {
      "severity": 5,
      "matchPaths": [
        {"path": "/usr/bin/certutil"}
      ],
      "action": "Audit"
    }
  }
}
